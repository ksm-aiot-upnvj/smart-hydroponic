# =============================================================================
# Smart Hydroponic — environment template
#
# Copy to `.env` (gitignored) and fill in. Every value below is a safe
# placeholder: never put real credentials in this file.
#
# Which file belongs to which Compose project:
#   * repo root `.env`            -> docker-compose.dev.yml / docker-compose.prod.yml
#   * `monitoring/.env`           -> monitoring/docker-compose.yml (see monitoring/.env.example)
# Each Compose project loads only its own directory's `.env`; a variable defined
# for one project is NOT automatically visible to another.
# =============================================================================

# --- Database (backend) ------------------------------------------------------
# PGHOST/PGPORT are the coordinates the backend USES at runtime.
#   * host-backend (uvicorn on your laptop): PGHOST=localhost, PGPORT=<host port>
#   * containers: Compose overrides PGHOST/PGPORT with the in-network values.
PGHOST=localhost
PGPORT=5432
PGUSER=changeme_db_user
PGDATABASE=changeme_db_name
PGPASSWORD=changeme_local_only

# Optional. When set it takes precedence over PGHOST/PGPORT/... above, so it
# MUST describe a reachable database from wherever the backend runs.
# The containers blank this out automatically and rebuild it from PG* values.
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=

# --- JWT (backend) -----------------------------------------------------------
JWT_EXPIRES_IN=1h
JWT_PRIVATE_KEY=keys/private.pem
JWT_PUBLIC_KEY=keys/public.pem

# --- Bootstrap superuser (backend) ------------------------------------------
SUPERUSER_USERNAME=admin
SUPERUSER_EMAIL=admin@localhost
SUPERUSER_PASSWORD=changeme_local_only
SUPERUSER_ROLE=superadmin

# --- HTTP (backend) ----------------------------------------------------------
# Comma-separated browser origins, or "*" for local development.
# Credentials are only enabled when this is an explicit list (the browser
# rejects "*" combined with credentials).
CORS_ALLOW_ORIGINS=*

# --- CoAP (backend) ----------------------------------------------------------
# Bind address of the CoAP server started at app startup. The base image
# listens on UDP 8683; docker-compose publishes "8683:8683/udp".
COAP_HOST=0.0.0.0

# Aggregator / actuator tuning. Optional — the code has defaults.
HYDROPONIC_MIN_INTERVAL_SECONDS=0.1
HYDROPONIC_PAIR_TIMEOUT_SECONDS=60.0
HYDROPONIC_MOISTURE_THRESHOLD=60
HYDROPONIC_TEMPERATURE_THRESHOLD=30.0

# Outbound CoAP client used to command the ESP8266 actuator.
# Change COAP_ACTUATOR_HOST to the actuator's address on YOUR network; do not
# rely on the built-in fallback address in backend/utils/coap_actuator_client.py.
COAP_ACTUATOR_HOST=127.0.0.1
COAP_ACTUATOR_PORT=5683
COAP_ACTUATOR_CONTROL_PATH=actuator/control
COAP_ACTUATOR_TIMEOUT_SECONDS=5

# --- Ports used by docker-compose -------------------------------------------
# Host port published for the bundled dev database.
POSTGRES_HOST_PORT=5433
# Port PostgreSQL listens on INSIDE the container/network. Compose uses this
# for the api container's PGPORT; change only if the database image differs.
POSTGRES_INTERNAL_PORT=5432

# --- Production only (docker-compose.prod.yml) ------------------------------
# DNS name of the separately deployed database on the external network
# `ksm-aiot-network`. Verify with: docker network inspect ksm-aiot-network
PROD_PGHOST=database-service-ksm-aiot

# --- Legacy / unused (kept only so old local .env files keep parsing) --------
# The backend and Compose do not read these. Remove them from your local `.env`.
# HOST, HOSTDEV, PORT, PORT_WS, COAP_PORT and JWT_SECRET are leftovers from
# earlier revisions; JWT_SECRET was replaced by the JWT_PRIVATE_KEY /
# JWT_PUBLIC_KEY pair.
