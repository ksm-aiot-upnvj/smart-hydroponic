# =============================================================================
# Smart Hydroponic — environment template
#
# Copy to `.env` (gitignored) and fill in. Every value below is a safe
# placeholder: never put real credentials in this file.
#
# Which file belongs to which Compose project:
#   * repo root `.env`            -> docker-compose.dev.yml / docker-compose.prod.yml
#   * `monitoring/.env`           -> monitoring/docker-compose.yml (see monitoring/.env.example)
# Each Compose project loads only its own directory's `.env`; a variable defined
# for one project is NOT automatically visible to another.
# =============================================================================

# --- Database (backend) ------------------------------------------------------
# PGHOST/PGPORT are the coordinates the backend USES at runtime.
#   * host-backend (uvicorn on your laptop): PGHOST=localhost, PGPORT=<host port>
#   * containers: Compose overrides PGHOST/PGPORT with the in-network values.
PGHOST=localhost
PGPORT=5432
PGUSER=changeme_db_user
PGDATABASE=changeme_db_name
PGPASSWORD=changeme_local_only

# Optional. When set it takes precedence over PGHOST/PGPORT/... above, so it
# MUST describe a reachable database from wherever the backend runs.
# The containers blank this out automatically and rebuild it from PG* values.
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=

# Bounded database wait performed by backend/entrypoint.sh before migrations.
# The container exits non-zero if the database is still unreachable after
# DB_STARTUP_MAX_ATTEMPTS attempts spaced DB_STARTUP_RETRY_INTERVAL seconds
# apart. Defaults: 30 attempts x 2s = up to 60s.
DB_STARTUP_MAX_ATTEMPTS=30
DB_STARTUP_RETRY_INTERVAL=2

# --- JWT (backend) -----------------------------------------------------------
JWT_EXPIRES_IN=1h
JWT_PRIVATE_KEY=keys/private.pem
JWT_PUBLIC_KEY=keys/public.pem

# --- Bootstrap superuser (backend) ------------------------------------------
SUPERUSER_USERNAME=admin
SUPERUSER_EMAIL=admin@localhost
SUPERUSER_PASSWORD=changeme_local_only
SUPERUSER_ROLE=superadmin

# --- HTTP (backend) ----------------------------------------------------------
# Comma-separated browser origins, or "*" for local development.
# Credentials are only enabled when this is an explicit list (the browser
# rejects "*" combined with credentials).
# Production does NOT read this variable: docker-compose.prod.yml sets
# CORS_ALLOW_ORIGINS from PROD_CORS_ALLOW_ORIGINS below, so the wildcard here can
# never leak into production. See "Production only" further down.
CORS_ALLOW_ORIGINS=*

# --- CoAP (backend) ----------------------------------------------------------
# Bind address of the CoAP server started at app startup. The base image
# listens on UDP 8683; docker-compose publishes "8683:8683/udp".
COAP_HOST=0.0.0.0

# Aggregator / actuator tuning. Optional — the code has defaults.
HYDROPONIC_MIN_INTERVAL_SECONDS=0.1
HYDROPONIC_PAIR_TIMEOUT_SECONDS=60.0
HYDROPONIC_MOISTURE_THRESHOLD=60
HYDROPONIC_TEMPERATURE_THRESHOLD=30.0

# --- Ports used by docker-compose -------------------------------------------
# Host port published for the bundled dev database.
POSTGRES_HOST_PORT=5433
# Port PostgreSQL listens on INSIDE the container/network. Compose uses this
# for the api container's PGPORT; change only if the database image differs.
POSTGRES_INTERNAL_PORT=5432

# --- Production only (docker-compose.prod.yml) ------------------------------
# DNS name of the separately deployed database on the external network
# `ksm-aiot-network`. Verify with: docker network inspect ksm-aiot-network
PROD_PGHOST=database-service-ksm-aiot

# Required production bind paths. Uncomment and set these in `.env` for Compose
# CLI, or as stack environment variables in Portainer. Do not put real paths
# containing sensitive directories or credentials in Git. Confirm both paths
# exist on the Docker host before deploying.
# PROD_KEYS_DIR=/home/admin-iot/ksm-aiot/smart-hydroponic/keys
# PROD_ENTRYPOINT_PATH=/home/admin-iot/ksm-aiot/smart-hydroponic/entrypoint.sh

# Image tags deployed by docker-compose.prod.yml. `latest` moves on every
# release, so two deploys with the same .env may run different code. Pin these to
# the tags published by .github/workflows/docker-push-*.yml (`backend-v1.5.0`,
# `frontend-v1.5.0`), or to an image digest, when a reproducible deploy or a
# clean rollback is needed. See docs/backend/deploy_python.md.
BACKEND_IMAGE_TAG=latest
FRONTEND_IMAGE_TAG=latest

# Browser origins allowed to call the API cross-origin IN PRODUCTION.
# Leave empty for the normal deployment: the browser reaches the API through the
# frontend container's nginx, so requests are same-origin and need no CORS
# header. If the API is really called from another origin, list those origins
# explicitly (comma-separated); never use "*".
PROD_CORS_ALLOW_ORIGINS=

# --- Frontend dev server (frontend-vue) -------------------------------------
# Consumed by frontend-vue/vite.config.ts to proxy /smart-hydroponic to the
# backend during `npm run dev`. Export it in the shell before starting Vite
# (Vite does NOT read this root .env file):
#   PowerShell:  $env:VITE_API_TARGET="http://127.0.0.1:8000"; npm run dev
#   bash:        VITE_API_TARGET=http://127.0.0.1:8000 npm run dev
# Defaults to http://127.0.0.1:8000 when unset.
# VITE_API_TARGET=http://127.0.0.1:8000

# Timeout (ms) applied to every API request by frontend-vue/src/http.ts. Without
# it a backend that accepts the connection but never answers keeps the request —
# and the UI loading state — pending forever. Defaults to 15000 ms; a missing or
# malformed value falls back to that default and warns in the browser console.
# Export it in the shell alongside VITE_API_TARGET (Vite does not read this file):
# VITE_API_TIMEOUT_MS=15000

# --- Legacy / unused (kept only so old local .env files keep parsing) --------
# The backend and Compose do not read these. Remove them from your local `.env`.
# HOST, HOSTDEV, PORT, PORT_WS and COAP_PORT are leftovers from earlier
# revisions and can be deleted.
