# =============================================================================
# Monitoring stack environment template (Prometheus + node-exporter + Grafana)
# Copy to `monitoring/.env` (gitignored) or pass with `--env-file`.
# Never commit the real `monitoring/.env`.
# =============================================================================

# --- Host ports (published on 127.0.0.1 only) --------------------------------
PROMETHEUS_PORT=9090
NODE_EXPORTER_PORT=9100
GRAFANA_PORT=3000

# === Required to change before any shared/production deployment ==============
# Never reuse the default Grafana credentials outside a local machine.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_local_only
# Public URL Grafana is reached through, including the trailing slash.
GRAFANA_ROOT_URL=http://localhost:3000/
# Set to true only when Grafana is served under a sub-path by a reverse proxy.
GRAFANA_SERVE_FROM_SUB_PATH=false
